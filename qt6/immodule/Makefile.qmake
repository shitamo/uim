####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt6/plugins/platforminputcontexts || mkdir -p $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt6/plugins/platforminputcontexts
	$(QINSTALL_PROGRAM) $(TARGET) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt6/plugins/platforminputcontexts/$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt6/plugins/platforminputcontexts/$(TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt6/plugins/platforminputcontexts/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

